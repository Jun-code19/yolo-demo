FROM python:3.10-slim

WORKDIR /app

RUN echo "deb http://mirrors.aliyun.com/debian/ bullseye main non-free contrib" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian-security/ bullseye-security main non-free contrib" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian/ bullseye-updates main non-free contrib" >> /etc/apt/sources.list

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libpq-dev \
    tzdata \
    fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

# CPU 镜像不装 ffmpeg（apt 依赖大、易超时）；设备探活用 OpenCV，拉流走 cv2 / ffmpeg-python 回退

RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata

COPY pip.conf /etc/pip.conf
COPY requirements.base.txt requirements.detect-server.txt ./
RUN pip install --no-cache-dir "numpy==1.26.4" \
    && pip install --no-cache-dir -r requirements.base.txt -r requirements.detect-server.txt

COPY . .

RUN set -e; \
    WHEEL=""; \
    for f in /app/vendor/*.whl /app/docs/NetSDK*.whl; do \
      if [ -f "$f" ]; then WHEEL="$f"; break; fi; \
    done; \
    if [ -n "$WHEEL" ]; then \
      pip install --no-cache-dir "$WHEEL" && echo "NetSDK installed: $WHEEL"; \
    else \
      echo "WARN: 未找到 NetSDK wheel（请放入 vendor/ 或 docs/ 后重建镜像)"; \
    fi

RUN mkdir -p models storage uploads

ENV CUDA_VISIBLE_DEVICES=-1 FORCE_CPU=1 \
    YOLO_AUTOINSTALL=false ULTRALYTICS_OFFLINE=1 YOLO_NO_ANALYTICS=1 NO_VERSION_CHECK=1

EXPOSE 8000
CMD ["uvicorn", "base_detect_server:app", "--host", "0.0.0.0", "--port", "8000"]
