# 不跑 apt-get：国内部分镜像对 debian-security 会 403/404；
# 官方 python slim 已自带 ca-certificates / tzdata，直接配置时区即可。
FROM python:3.10.14-slim-bookworm

WORKDIR /app

ENV TZ=Asia/Shanghai
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

COPY pip.conf /etc/pip.conf
COPY requirements.base.txt requirements.data-server.txt ./
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip \
    && pip install --no-cache-dir "numpy==1.26.4" \
    && pip install --no-cache-dir -r requirements.base.txt -r requirements.data-server.txt \
    && pip install --no-cache-dir --force-reinstall --no-deps "pandas==2.0.3" \
    && pip install --no-cache-dir "pandas==2.0.3"

COPY . .

RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8001
CMD ["python", "base_data_server.py"]
